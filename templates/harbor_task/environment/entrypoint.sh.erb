#!/bin/sh
set -eu

# Harbor task environment entrypoint.
#
# The GitHub token is injected only at run time via task.toml
# [environment.env] (never baked into image layers) and the sandbox
# repository is private, so a build-time `git clone` cannot work. We
# clone here, at container start, when GH_TOKEN/GITHUB_TOKEN are
# present and the `gh auth git-credential` helper (configured in the
# Dockerfile) authenticates headlessly.
#
# Harbor starts the container with `sh -c "sleep infinity"`; this
# ENTRYPOINT prepares /workspace first, then `exec "$@"` hands off to
# that command so the container stays alive for the agent.
#
# Debug visibility: Harbor deletes the container after a failed
# `docker compose up --wait` (so `docker logs` is unrecoverable) and
# merges compose stderr into stdout (hence `Stderr: None`). To keep
# the container's own output visible, everything below is duplicated
# to the Harbor convention publish dir (/logs/artifacts), which
# Harbor bind-mounts to <trial>/artifacts/logs/artifacts/ on the
# host and keeps in --debug runs (workspace/ is not deleted). All
# log-file writes are best-effort (|| true) so a missing mount never
# breaks the clone itself. NOTE: /bin/sh is dash (no pipefail), so
# git output is captured via a temp file rather than a pipeline.
ADB_LOG_DIR="/logs/artifacts"
ADB_LOG="${ADB_LOG_DIR}/entrypoint.log"
mkdir -p "$ADB_LOG_DIR" 2>/dev/null || true
touch "$ADB_LOG" 2>/dev/null || true
adb_note() { echo "$@"; echo "$@" >>"$ADB_LOG" 2>/dev/null || true; }
adb_err() { echo "$@" >&2; echo "$@" >>"$ADB_LOG" 2>/dev/null || true; }

# Memory watchdog: sample memory/swap/disk every 5 seconds.
# Runs in background, writes to stderr AND the entrypoint log (which
# Harbor preserves under artifacts/logs/artifacts/).
# Diagnostic-grade: logs a STARTUP banner plus a HEARTBEAT line for
# EVERY sample (not only under pressure), so a later silent SIGKILL
# (exit 137) can be told apart from "watchdog never ran" and from
# "memory was fine". A PRESSURE flag marks samples over threshold.
# POSIX sh (dash) compatible: no `local`, no ternary in $(( )).
adb_watchdog() {
  adb_note "MEMORY WATCHDOG STARTUP: pid=$$ interval=5s thresholds: used>80% or used>2GB, avail<20%"
  _beat=0
  while true; do
    _beat=$((_beat + 1))
    _total=$(awk '/MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
    _free=$(awk '/MemFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
    _avail=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
    case "$_total" in ''|*[!0-9]*) _total=0 ;; esac
    case "$_free" in ''|*[!0-9]*) _free=0 ;; esac
    case "$_avail" in ''|*[!0-9]*) _avail=0 ;; esac
    _used=$((_total - _free))
    _used_pct=0; _avail_pct=0
    if [ "$_total" -gt 0 ]; then
      _used_pct=$((_used * 100 / _total))
      _avail_pct=$((_avail * 100 / _total))
    fi
    _swap_total=$(awk '/SwapTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
    _swap_free=$(awk '/SwapFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
    case "$_swap_total" in ''|*[!0-9]*) _swap_total=0 ;; esac
    case "$_swap_free" in ''|*[!0-9]*) _swap_free=0 ;; esac
    _swap_used=$((_swap_total - _swap_free))
    _swap_pct=0
    if [ "$_swap_total" -gt 0 ]; then
      _swap_pct=$((_swap_used * 100 / _swap_total))
    fi
    # Disk snapshot (best-effort): pressure deaths are also caused by
    # full disks during gem/skill downloads. Single line, no header.
    _disk=$(df -h / /tmp /workspace 2>/dev/null | awk 'NR>1 {printf "%s:%s/%s(%s) ", $6, $3, $2, $5}')
    _flag="ok"
    if [ "$_total" -gt 0 ] && { [ "$_used_pct" -gt 80 ] || [ "$_used" -gt 2000000 ]; }; then
      _flag="PRESSURE"
    elif [ "$_total" -gt 0 ] && [ "$_avail_pct" -lt 20 ]; then
      _flag="LOW_AVAIL"
    fi
    adb_note "MEMORY WATCHDOG HEARTBEAT #${_beat} [${_flag}]: total=${_total}kB free=${_free}kB avail=${_avail}kB used=${_used}kB (${_used_pct}%) swap_used=${_swap_used}kB (${_swap_pct}%) disk='${_disk}'"
    sleep 5
  done
}
REPO_URL="${REPO_URL:?REPO_URL must be set}"
BASE_BRANCH="${BASE_BRANCH:-main}"
WORKSPACE_DIR="${WORKSPACE_DIR:-/workspace}"

# Fail loudly instead of letting `set -e` kill the container with an
# opaque status (which Harbor surfaces only as
# `docker compose ... exited (255)` -> RuntimeError). Capture git's
# real output to a log AND stderr so it lands in `docker logs` and in
# Harbor's exception output.
if [ ! -d "$WORKSPACE_DIR/.git" ]; then
  adb_note "Cloning $REPO_URL into $WORKSPACE_DIR (branch: $BASE_BRANCH)"
  # The image sets WORKDIR to $WORKSPACE_DIR (/workspace), so this
  # process starts with its cwd inside the very directory we are about
  # to remove. `rm -rf` on the cwd leaves getcwd() failing and
  # `git clone` aborts with `fatal: Unable to read current working
  # directory` (exit 128). Step out to / first so the clone has a valid
  # cwd, then wipe and re-clone directly into $WORKSPACE_DIR (the repo
  # lives at /workspace itself, Harbor's standard agent workspace).
  cd /
  rm -rf "$WORKSPACE_DIR"
  clone_log="$(mktemp)"
  if timeout 120 git clone "$REPO_URL" "$WORKSPACE_DIR" >"$clone_log" 2>&1; then
    cat "$clone_log"
    cat "$clone_log" >>"$ADB_LOG" 2>/dev/null || true
    rm -f "$clone_log"
    checkout_log="$(mktemp)"
    if git -C "$WORKSPACE_DIR" checkout "$BASE_BRANCH" >"$checkout_log" 2>&1; then
      cat "$checkout_log"
      cat "$checkout_log" >>"$ADB_LOG" 2>/dev/null || true
      if [ -f "$WORKSPACE_DIR/.skills" ]; then
        # skillkit resolves the .skills manifest and installs skills
        # GLOBALLY under $HOME/.cline/skills (see `--global` below), so
        # the agent's Cline loads them regardless of the repo's cwd.
        adb_note "adb-entrypoint: installing skills (cwd=$(pwd), workspace=$WORKSPACE_DIR)"
        adb_note "adb-entrypoint: skills pre-state: df $(df -h / /tmp "$WORKSPACE_DIR" 2>/dev/null | awk 'NR>1 {printf "%s:%s/%s(%s) ", $6, $3, $2, $5}')"
        skills_log="$(mktemp)"
        # Guard against `set -e` (line 2): a failing `xaa` must NOT kill
        # PID 1 before skills_status is captured -- hence if/then/else.
        if command -v xaa >/dev/null 2>&1; then
          if ( cd "$WORKSPACE_DIR" && timeout 300 xaa install-skills --global --debug >"$skills_log" 2>&1 ); then
            skills_status=0
          else
            skills_status=$?
          fi
        else
          echo "xaa install-skills: command not found" >"$skills_log" 2>&1
          skills_status=127
        fi
        cat "$skills_log"
        cat "$skills_log" >>"$ADB_LOG" 2>/dev/null || true
        rm -f "$skills_log"
        adb_note "adb-entrypoint: skills done (exit=$skills_status, cwd=$(pwd))"
        adb_note "adb-entrypoint: skills post-state: df $(df -h / /tmp "$WORKSPACE_DIR" 2>/dev/null | awk 'NR>1 {printf "%s:%s/%s(%s) ", $6, $3, $2, $5}'); installed: $(ls -d "$HOME/.cline/skills" 2>/dev/null || echo MISSING)"
        if [ "$skills_status" -ne 0 ]; then
          adb_err "adb-entrypoint: WARNING: 'xaa install-skills' failed (exit $skills_status)."
        fi
      fi
    else
      checkout_status=$?
      adb_err "adb-entrypoint: ERROR: 'git checkout $BASE_BRANCH' failed (exit $checkout_status)."
      cat "$checkout_log" >&2 || true
      cat "$checkout_log" >>"$ADB_LOG" 2>/dev/null || true
      exit "$checkout_status"
    fi
    rm -f "$checkout_log"
  else
    clone_status=$?
    adb_err "adb-entrypoint: ERROR: 'git clone $REPO_URL' failed (exit $clone_status)."
    adb_err "adb-entrypoint: This is almost always an auth or network problem. Verify that:"
    adb_err "adb-entrypoint:   * AGENT_GITHUB_TOKEN / GH_TOKEN is set, valid, and not expired,"
    adb_err "adb-entrypoint:   * it has contents:read on this PRIVATE sandbox repo, and"
    adb_err "adb-entrypoint:   * this container has network egress to github.com."
    adb_err "adb-entrypoint: --- git output follows ---"
    cat "$clone_log" >&2 || true
    cat "$clone_log" >>"$ADB_LOG" 2>/dev/null || true
    exit "$clone_status"
  fi
else
  # Idempotent: Harbor restores the agent's /workspace into the
  # verifier before tests run, so an existing checkout is left as-is.
  adb_note "$WORKSPACE_DIR already contains a git checkout; leaving it in place"
fi

# Mark the container ready for Harbor. Harbor starts the agent container
# with `docker compose up -d --wait`; the Dockerfile HEALTHCHECK succeeds
# only when this marker exists, so Harbor blocks the agent phase until
# clone + skills install have completed (or failed/exited).
touch /tmp/adb-ready 2>/dev/null || true
if [ ! -f /tmp/adb-ready ]; then
  adb_err "adb-entrypoint: ERROR: could not create ready marker /tmp/adb-ready"
  exit 1
fi
adb_note "adb-entrypoint: ready marker written (/tmp/adb-ready)"

# Start the memory watchdog in the background before handing off to the
# agent command. It logs to stderr + entrypoint.log every time memory
# pressure is high, so a silent SIGKILL (exit 137) leaves a trace.
adb_watchdog &
adb_note "Memory watchdog started (PID $!)"

exec "$@"
