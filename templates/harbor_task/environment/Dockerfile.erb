# Base image for the Harbor task environment.
# Pinned to the exact Ruby patch (3.4.11) the benchmark scenarios are
# validated against, so the floating `3.4` tag can never silently drift
# the interpreter under the agent and the verifier.
FROM ruby:3.4.11-bookworm

# Install required system packages.
# git: clone/push the sandbox repo; gh: issues/PRs/API without
# interactive login (reads GH_TOKEN/GITHUB_TOKEN at run time).
# ca-certificates/curl/gnupg: fetch the official gh apt keyring.
RUN apt-get update -qq && apt-get install -y --no-install-recommends   ca-certificates   curl   git   gnupg   && rm -rf /var/lib/apt/lists/*

# Install the official GitHub CLI from cli.github.com packages.
# Key fingerprints (SHA256): see https://github.com/cli/cli/blob/trunk/docs/install_linux.md
RUN mkdir -p /usr/share/keyrings \
  && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
  && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    > /etc/apt/sources.list.d/github-cli.list \
  && apt-get update -qq && apt-get install -y --no-install-recommends gh \
  && rm -rf /var/lib/apt/lists/* \
  && git --version && gh --version

# Install Node.js 22 (LTS) from NodeSource plus the Cline CLI.
# cline-rb shells out to the `cline` binary (Cline::Utils::Os::Linux#cline_exe
# returns ["cline"]) via PTY.spawn; without it every xaa run aborts with
# Errno::ENOENT at cline/cli.rb:307. Node 22 meets the CLI requirement
# (Node 20+, 22 recommended); the npm package resolves the platform binary
# so no extra runtime is needed. Both pins are deliberate, bump together
# when a newer Cline release is adopted.
ENV NODE_MAJOR=22 CLINE_VERSION=3.0.71
RUN mkdir -p /etc/apt/keyrings \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_$NODE_MAJOR.x nodistro main" \
    > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update -qq && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g cline@$CLINE_VERSION \
  && node --version && npm --version && cline --version

# Non-secret git/gh defaults baked into the image. Credentials
# themselves are injected at run time via [environment.env]
# (GH_TOKEN/GITHUB_TOKEN) so they never appear in image layers.
RUN git config --global --add safe.directory /workspace/repo \
  && git config --global user.name "agentic-dev-bench" \
  && git config --global user.email "agentic-dev-bench@local" \
  && git config --global credential.helper "" \
  && git config --global --add credential.helper "!gh auth git-credential"
ENV GIT_TERMINAL_PROMPT=0 GH_PROMPT_DISABLED=1 GCM_INTERACTIVE=never

# The x_aeon_agents gem is installed into the image's default gem
# home (/usr/local/bundle, on PATH for every user) so its `xaa` CLI
# is available system-wide -- to the non-root agent running
# agents/scripts/xaa.sh as well as to the separate verifier -- rather
# than into the sandbox repository's project bundle. The gem is pinned
# to the exact release the benchmark scenarios are validated against;
# bump deliberately when a newer x_aeon_agents release is adopted.
RUN gem install --no-document x_aeon_agents -v 1.3.0

# Clone the sandbox repository at container start (run time), NOT at
# build time: the GitHub token is injected only via [environment.env]
# at run time and the sandbox repo is private, so a build-time clone
# is impossible and would risk baking credentials into image layers.
# entrypoint.sh performs the authenticated clone once GH_TOKEN /
# GITHUB_TOKEN are available (the image wires `gh auth git-credential`
# as the git credential helper). The repository URL is not secret.
COPY entrypoint.sh /usr/local/bin/adb-entrypoint.sh
RUN chmod +x /usr/local/bin/adb-entrypoint.sh
ENV REPO_URL="<%= @sandbox['repository_url'] %>" BASE_BRANCH="main"

# X-Aeon Agents session state lives outside /workspace (see
# x_aeon_agents_config.rb): task.toml uploads the whole /workspace as
# an artifact into the separate verifier, and a sessions/... tree
# inside it breaks `docker compose cp` on Windows (MAX_PATH /
# transient files). The env-var config file is evaluated last by
# XAeonAgents::Config.load, so it wins over ~/ and ./. configs.
COPY x_aeon_agents_config.rb /workspace/x_aeon_agents.rb
ENV X_AEON_AGENTS_CONFIG=/workspace/x_aeon_agents.rb

# Set the working directory inside the container to the cloned sandbox
# repository (adb-entrypoint.sh clones the GitHub sandbox into
# /workspace/repo).
WORKDIR /workspace/repo

# Harbor overrides the image CMD (`sh -c "sleep infinity"`) but honors
# ENTRYPOINT, so adb-entrypoint.sh runs the clone first, then hands
# off via `exec "$@"` to keep the container alive for the agent.
ENTRYPOINT ["/usr/local/bin/adb-entrypoint.sh"]
