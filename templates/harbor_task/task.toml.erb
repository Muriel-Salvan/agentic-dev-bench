# Harbor task configuration
language = "ruby"
framework = "unknown"
environment_type = "docker"

# Copy the agent's working tree into the verifier before grading.
# With [verifier] environment_mode = "separate" below, Harbor starts
# the verifier from a fresh sandbox WITHOUT the agent's filesystem
# changes. Declaring /workspace as an artifact makes Harbor collect
# it after the agent finishes and restore it to its original path
# (/workspace) in the verifier, so tests/test.sh grades the agent's
# actual clone in place. `destination` only affects the host-side
# save path; the verifier always receives the source path.
#
# The repo is cloned directly into /workspace (the image WORKDIR), so
# the artifact source (/workspace) EQUALS the container's working
# directory. This is deliberate: Harbor empties the artifact dir
# before restoring it, and on Windows the upload falls back to an
# exec that inherits the container cwd. If the source were a STRICT
# ANCESTOR of WORKDIR (e.g. source=/workspace but WORKDIR=/workspace/repo),
# emptying /workspace would delete /workspace/repo (the cwd) and that
# exec would die with `chdir to cwd ("/workspace/repo") ... no such file
# or directory` (exit 127). Keeping them equal avoids that trap.
# Agent debug/session state is kept OUT of /workspace (it lives under
# the /logs/agent bind mount; see environment/x_aeon_agents_config.rb).
artifacts = [
  { source = "/workspace", destination = "workspace" },
]

# Give Harbor up to 15 minutes to wait for the entrypoint to finish
# cloning the sandbox repo and installing Cline skills. Harbor enforces
# this via `asyncio.wait_for` around `docker compose up -d --wait`, so a
# hung entrypoint becomes a clean EnvironmentStartTimeoutError instead of
# a silent half-initialized container. The entrypoint's own `timeout`
# bounds on clone (120s) and skills install (300s) keep normal runs
# well under this ceiling.
[environment]
build_timeout_sec = 900.0
# Harbor interpolates ${VAR} from the `harbor run` process
# environment at run time, so the secret never lands in the
# Docker image layers. HarborRunner#run! always exports
# AGENT_GITHUB_TOKEN (= AGENT_GITHUB_TOKEN or GITHUB_TOKEN
# from the host) into that process env, hence the simple
# ${AGENT_GITHUB_TOKEN} references below (no nested fallback
# syntax, which Harbor does not support).
# GH_TOKEN and GITHUB_TOKEN both feed `gh` headless auth;
# GIT_TERMINAL_PROMPT=0 turns auth failures into fast errors
# instead of interactive prompts.
[environment.env]
GH_TOKEN = "${AGENT_GITHUB_TOKEN}"
GITHUB_TOKEN = "${AGENT_GITHUB_TOKEN}"
# Cline API key for the agent container's non-interactive (BYOK) auth.
# HarborRunner always exports CLINE_API_KEY into the `harbor run` process
# env, so this interpolation is always populated. The `cline` CLI (driven
# by cline-rb via PTY.spawn within xaa) reads it to authenticate without
# the OAuth device-code flow, which would otherwise spawn xdg-open and
# crash in the headless container. Only the agent container needs it; the
# separate verifier below just runs tests, so [verifier.env] omits it.
CLINE_API_KEY = "${CLINE_API_KEY}"
# OpenRouter API key for the RubyLLM-driven AiAgents helpers (diff
# interpreter, executor, one-line diff summarizer), configured to the
# `openrouter/free` model in environment/x_aeon_agents_config.rb.
# HarborRunner always exports OPENROUTER_API_KEY into the `harbor run`
# process env, so this interpolation is always populated. Only the agent
# container needs it; the separate verifier below just runs tests, so
# [verifier.env] omits it.
OPENROUTER_API_KEY = "${OPENROUTER_API_KEY}"
GIT_TERMINAL_PROMPT = "0"
GH_PROMPT_DISABLED = "1"

# Run the verifier in a dedicated, separate container so the
# tests/ folder never lands in the agent's environment and
# grading is isolated from whatever the agent left in its own
# filesystem. Without a verifier-specific image or build
# definition, Harbor starts a fresh copy of the agent
# environment (built from environment/Dockerfile) and uploads
# tests/ to /tests/ there. A separate verifier does NOT inherit
# the agent's filesystem changes on its own, but the top-level
# `artifacts` declaration above copies the agent's /workspace
# into this verifier first, so tests/test.sh grades the agent's
# actual working tree in place (its `origin` points at the
# GitHub sandbox and carries the pushed branch).
[verifier]
environment_mode = "separate"

# The verifier clones the sandbox GitHub repository to grade the
# pushed branch, so give it read access too.
[verifier.env]
GH_TOKEN = "${AGENT_GITHUB_TOKEN}"
GITHUB_TOKEN = "${AGENT_GITHUB_TOKEN}"
